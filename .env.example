VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: Cloudflare Turnstile site key — adds a CAPTCHA check to sign-in/
# sign-up/password-reset. Leave unset to disable (dev default). See README.
VITE_TURNSTILE_SITE_KEY=

# Optional: Sentry DSN — reports uncaught errors so you know if something
# breaks for a real visitor. Leave unset to disable. See README.
VITE_SENTRY_DSN=
